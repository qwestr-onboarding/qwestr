FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS base
WORKDIR /app
RUN mkdir -p /app/wwwroot/uploads && chown -R app:app /app/wwwroot
USER $APP_UID
EXPOSE 8080
EXPOSE 8081

FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
ARG BUILD_CONFIGURATION=Debug
WORKDIR /src
COPY ["QwestrAPI/QwestrAPI.csproj", "QwestrAPI/"]
RUN dotnet restore "QwestrAPI/QwestrAPI.csproj"
COPY . .
WORKDIR "/src/QwestrAPI"
RUN dotnet build "QwestrAPI.csproj" -c $BUILD_CONFIGURATION -o /app/build

FROM build AS publish
ARG BUILD_CONFIGURATION=Release
RUN dotnet publish "QwestrAPI.csproj" -c $BUILD_CONFIGURATION -o /app/publish /p:UseAppHost=false

FROM base AS final
WORKDIR /app
COPY --from=publish /app/publish .
ENTRYPOINT ["dotnet", "QwestrAPI.dll"]
