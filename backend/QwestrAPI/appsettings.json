{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "Llm": {
    "DefaultProvider": "YandexGpt",
    "UseFake": false,
    "YandexGpt": {
      "ApiKey": "API_KEY",
      "FolderId": "FOLDER_ID",
      "ModelUri": "gpt://FOLDER_ID/yandexgpt-lite",
      "Endpoint": "https://llm.api.cloud.yandex.net/foundationModels/v1/completion",
      "Temperature": 0.2,
      "MaxTokens": 100000
    },
    "Gemini": {
      "ApiKey": "API_KEY",
      "Model": "gemini-flash-latest",
      "Temperature": 0.2
    },
    "Qwen": {
      "ApiKey": "",
      "BaseUrl": "https://dashscope-intl.aliyuncs.com/compatible-mode/v1",
      "Model": "qwen3.6-plus",
      "Temperature": 0.7,
      "MaxTokens": 10000,
      "TimeoutSeconds": 6000
    }
  },
  "Analytics": {
    "Llm": {
      "InsightCooldownHours": 0
    },
    "BackgroundJobs": {
      "DailySnapshotEnabled": true,
      "DailySnapshotTimeUtc": "02:00",
      "DailyInsightWarmupEnabled": true,
      "DailyInsightWarmupTimeUtc": "06:00"
    }
  },
  "Onboarding": {
    "Ai": {
      "MaxGenerationsPerDay": 10,
      "DefaultMaxStages": 5,
      "DefaultMaxStepsPerStage": 10
    }
  },
  "ConnectionStrings": {
    "Analytics": "Host=localhost;Port=5432;Database=qwestr-db;User Id=postgres;Password=postgres;",
    "Gamification": "Host=localhost;Port=5432;Database=qwestr-db;User Id=postgres;Password=postgres;",
    "Identity": "Host=localhost;Port=5432;Database=qwestr-db;User Id=postgres;Password=postgres;",
    "Integration": "",
    "Notifications": "Host=localhost;Port=5432;Database=qwestr-db;User Id=postgres;Password=postgres;",
    "Onboarding": "Host=localhost;Port=5432;Database=qwestr-db;User Id=postgres;Password=postgres;"
  },
  "Email": {
    "Smtp": {
      "Host": "smtp.mail.ru",
      "Port": 465,
      "UseSsl": true,
      "Username": "notifications@qwestr.ru",
      "Password": ""
    },
    "From": {
      "Address": "notifications@qwestr.ru",
      "DisplayName": "Qwestr"
    },
    "ReplyTo": "support@qwestr.ru",
    "BaseUrl": "https://qwestr.ru"
  },
  "Notifications": {
    "Defaults": {
      "UserInvited":                { "InApp": false, "Email": true },
      "AccountActivated":           { "InApp": true,  "Email": true },
      "ScenarioAssigned":           { "InApp": true,  "Email": true },
      "ScenarioCompleted":          { "InApp": true,  "Email": false },
      "StepCompleted":              { "InApp": false, "Email": false },
      "ScenarioReminderInactive":   { "InApp": true,  "Email": true },
      "BadgeEarned":                { "InApp": true,  "Email": false },
      "LevelUp":                    { "InApp": true,  "Email": false },
      "LeaderboardPositionChanged": { "InApp": true,  "Email": false }
    },
    "Throttling": {
      "ScenarioReminderInactive":   "24:00:00",
      "LeaderboardPositionChanged": "01:00:00"
    },
    "Outbox": {
      "PollIntervalSeconds": 10,
      "BatchSize": 20,
      "StuckSendingTimeoutMinutes": 10,
      "RetentionDays": 30
    }
  },
  "Jwt": {
    "Issuer": "QwestrAPI",
    "Audience": "QwestrClient",
    "Secret": "super-secret-key-super-secret-key-super-secret-key-super-secret-key",
    "AccessTokenExpiryDays": 2
  }
}
