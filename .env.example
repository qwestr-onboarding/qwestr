# PostgreSQL
POSTGRES_PASSWORD=change_me_use_strong_password

# JWT — минимум 64 символа, случайная строка (openssl rand -hex 32)
JWT_SECRET=change_me_very_long_random_secret_minimum_64_chars_here

# Email (SMTP)
EMAIL_SMTP_PASSWORD=change_me

# YandexGPT
YANDEX_GPT_FOLDER_ID=change_me
YANDEX_GPT_API_KEY=change_me
YANDEX_GPT_MODEL_URI=gpt://FOLDER_ID/yandexgpt-lite

# Gemini
GEMINI_API_KEY=change_me

# Qwen
QWEN_API_KEY=change_me
