<footer style="background:#f8f8f8;border-top:1px solid #e0e0e0;padding:40px 24px;">
    <div style="max-width:1200px;margin:0 auto;">
        <MudGrid>
            <MudItem xs="12" sm="4">
                <MudStack Spacing="2">
                    <MudText Typo="Typo.h6" Style="font-weight:800;letter-spacing:-0.5px;">Qwestr</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Платформа для онбординга и мотивации сотрудников
                    </MudText>
                </MudStack>
            </MudItem>

            <MudItem xs="6" sm="2">
                <MudStack Spacing="2">
                    <MudText Typo="Typo.overline" Style="font-weight:600;">Продукт</MudText>
                    <MudLink Href="/pricing" Typo="Typo.body2" Color="Color.Default" Underline="Underline.None">
                        Тарифы
                    </MudLink>
                    <MudLink Href="/about" Typo="Typo.body2" Color="Color.Default" Underline="Underline.None">
                        О нас
                    </MudLink>
                </MudStack>
            </MudItem>

            <MudItem xs="6" sm="2">
                <MudStack Spacing="2">
                    <MudText Typo="Typo.overline" Style="font-weight:600;">Аккаунт</MudText>
                    <MudLink Href="/login" Typo="Typo.body2" Color="Color.Default" Underline="Underline.None">
                        Войти
                    </MudLink>
                    <MudLink Href="/register" Typo="Typo.body2" Color="Color.Default" Underline="Underline.None">
                        Регистрация
                    </MudLink>
                </MudStack>
            </MudItem>

            <MudItem xs="12" sm="4">
                <MudStack Spacing="2">
                    <MudText Typo="Typo.overline" Style="font-weight:600;">Правовая информация</MudText>
                    <MudLink Href="/terms" Typo="Typo.body2" Color="Color.Default" Underline="Underline.None">
                        Условия использования
                    </MudLink>
                    <MudLink Href="/privacy" Typo="Typo.body2" Color="Color.Default" Underline="Underline.None">
                        Политика конфиденциальности
                    </MudLink>
                </MudStack>
            </MudItem>
        </MudGrid>

        <MudDivider Class="my-4" />

        <MudText Typo="Typo.caption" Color="Color.Secondary" Align="Align.Center">
            © @DateTime.UtcNow.Year Qwestr. Все права защищены.
        </MudText>
    </div>
</footer>
