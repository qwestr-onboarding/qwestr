@using System.Globalization
<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Style="padding: 6px 14px; background: rgba(255, 193, 7, 0.12); border-radius: 20px; ">
    <MudIcon Icon="@QwestrIcons.Gamification.XpBadge" Color="Color.Warning" Size="Size.Small" />
    <MudText Typo="Typo.body2" Style="font-weight: 600">@PointsStr</MudText>
</MudStack>

@code {
    [Parameter] public int Points { get; set; }

    public string PointsStr => Points.ToString("N0", CultureInfo.InvariantCulture);
}
