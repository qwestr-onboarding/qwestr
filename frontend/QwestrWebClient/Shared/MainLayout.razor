@inherits LayoutComponentBase

@using Client.Infrastructure.Auth

<MudThemeProvider Theme="QwestrTheme.Theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<RouteGuard Mode="RouteGuardMode.TenantOnly">
    <MudLayout>
        <TopBar DrawerOpen="_drawerOpen" OnMenuToggle="ToggleDrawer" />

        <MudDrawer @bind-Open="_drawerOpen"
                   ClipMode="DrawerClipMode.Docked"
                   Variant="DrawerVariant.Mini"
                   MiniWidth="64px" Elevation="0" Class="border-r-1 mud-border-default">
            <SideNav Open="_drawerOpen" />
        </MudDrawer>

        <MudMainContent>
            <div class="content-wrapper">
                @Body
            </div>
        </MudMainContent>
    </MudLayout>

    <BottomNav />
</RouteGuard>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">&#x2716;</a>
</div>

@code {
    private bool _drawerOpen;

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
}
