@page "/"
@layout PublicLayout

<PageTitle>Qwestr — онбординг и мотивация сотрудников</PageTitle>

<section style="background:linear-gradient(135deg,#f8f9ff 0%,#eef1ff 100%);padding:100px 24px 80px;">
    <div style="max-width:800px;margin:0 auto;text-align:center;">
        <MudText Typo="Typo.h2" Style="font-weight:800;letter-spacing:-1px;margin-bottom:16px;">
            Онбординг, который <span style="color:#7c3aed;">работает</span>
        </MudText>
        <MudText Typo="Typo.h6" Color="Color.Secondary" Style="font-weight:400;max-width:560px;margin:0 auto 40px;">
            Помогите новым сотрудникам быстро влиться в команду с помощью геймифицированных сценариев адаптации
        </MudText>
        <MudStack Row="true" Justify="Justify.Center" Spacing="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       Size="Size.Large" Href="/register"
                       Style="border-radius:10px;padding:12px 32px;font-weight:600;">
                Начать бесплатно
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                       Size="Size.Large" Href="/about"
                       Style="border-radius:10px;padding:12px 32px;">
                Узнать больше
            </MudButton>
        </MudStack>
    </div>
</section>

<section style="padding:80px 24px;">
    <div style="max-width:1100px;margin:0 auto;">
        <MudText Typo="Typo.h4" Align="Align.Center" Style="font-weight:700;margin-bottom:48px;">
            Всё что нужно для адаптации
        </MudText>
        <MudGrid Spacing="4">
            <MudItem xs="12" sm="4">
                <MudPaper Outlined="true" Style="padding:32px 24px;border-radius:16px;height:100%;" Elevation="0">
                    <MudStack Spacing="2">
                        <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Style="margin-bottom:8px;">
                            <MudIcon Icon="@Icons.Material.Outlined.Route" />
                        </MudAvatar>
                        <MudText Typo="Typo.h6" Style="font-weight:700;">Сценарии онбординга</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            Создавайте структурированные пути адаптации с этапами, заданиями и дедлайнами
                        </MudText>
                    </MudStack>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudPaper Outlined="true" Style="padding:32px 24px;border-radius:16px;height:100%;" Elevation="0">
                    <MudStack Spacing="2">
                        <MudAvatar Color="Color.Secondary" Variant="Variant.Filled" Style="margin-bottom:8px;">
                            <MudIcon Icon="@Icons.Material.Outlined.EmojiEvents" />
                        </MudAvatar>
                        <MudText Typo="Typo.h6" Style="font-weight:700;">Геймификация</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            Баллы, уровни и бейджи мотивируют сотрудников проходить обучение с удовольствием
                        </MudText>
                    </MudStack>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudPaper Outlined="true" Style="padding:32px 24px;border-radius:16px;height:100%;" Elevation="0">
                    <MudStack Spacing="2">
                        <MudAvatar Color="Color.Tertiary" Variant="Variant.Filled" Style="margin-bottom:8px;">
                            <MudIcon Icon="@Icons.Material.Outlined.Analytics" />
                        </MudAvatar>
                        <MudText Typo="Typo.h6" Style="font-weight:700;">Аналитика HR</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            Отслеживайте прогресс каждого сотрудника и выявляйте узкие места в процессе
                        </MudText>
                    </MudStack>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </div>
</section>

<section style="background:#f8f9ff;padding:80px 24px;">
    <div style="max-width:600px;margin:0 auto;text-align:center;">
        <MudText Typo="Typo.h4" Style="font-weight:700;margin-bottom:16px;">
            Готовы начать?
        </MudText>
        <MudText Typo="Typo.body1" Color="Color.Secondary" Style="margin-bottom:32px;">
            Зарегистрируйте компанию и запустите первый сценарий онбординга уже сегодня
        </MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   Size="Size.Large" Href="/register"
                   Style="border-radius:10px;padding:12px 40px;font-weight:600;">
            Зарегистрировать компанию
        </MudButton>
    </div>
</section>
