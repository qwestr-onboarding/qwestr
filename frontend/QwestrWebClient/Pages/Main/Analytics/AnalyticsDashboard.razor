@page "/analytics"
@layout MainLayout

@using System.Security.Claims
@using Client.Infrastructure.Api.Endpoints.Analytics
@using Qwestr.Shared.Contracts.ApiDto.Analytics.Responses
@using Qwestr.Shared.Kernel.Enums.Analytics
@using Qwestr.Shared.Kernel.Enums.Identity
@using QwestrWebClient.Pages.Main.Analytics.Dialogs

@inject AnalyticsApi AnalyticsApi
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Nav
@inject SessionManager Session

<PageTitle>Аналитика — Qwestr</PageTitle>

@if (!_authorized)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_loading)
{
    <MudStack Spacing="3">
        <MudGrid Spacing="2">
            @for (var i = 0; i < 4; i++)
            {
                <MudItem xs="6" sm="3">
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="90px" Style="border-radius:12px;" />
                </MudItem>
            }
        </MudGrid>
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="160px" Style="border-radius:12px;" />
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="200px" Style="border-radius:12px;" />
    </MudStack>
}
else if (_dashboard is null)
{
    <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="pa-12">
        <MudIcon Icon="@Icons.Material.Outlined.BarChart" Size="Size.Large" Color="Color.Secondary" />
        <MudText Typo="Typo.body1" Color="Color.Secondary">Не удалось загрузить данные</MudText>
        <MudButton Variant="Variant.Outlined" OnClick="LoadAsync">Повторить</MudButton>
    </MudStack>
}
else
{
    <MudStack Spacing="4">

        @* Header *@
        <MudStack Row="true" AlignItems="AlignItems.Center">
            <MudStack Spacing="0">
                <MudText Typo="Typo.h6" Style="font-weight:700;">Аналитика</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">Обзор онбординга и вовлечённости</MudText>
            </MudStack>
            <MudSpacer />
            <MudStack Row="true" Spacing="1">
                <MudButton Variant="Variant.Outlined" Size="Size.Small"
                           StartIcon="@QwestrIcons.Gamification.Sparkles"
                           OnClick='() => Nav.NavigateTo("/analytics/insights")'>
                    AI Инсайты
                </MudButton>
                @*
                <MudButton Variant="Variant.Outlined" Size="Size.Small"
                           StartIcon="@Icons.Material.Outlined.Download"
                           OnClick="OpenExportAsync">
                    Экспорт
                </MudButton>
                *@
                <MudIconButton Icon="@Icons.Material.Outlined.Refresh" Size="Size.Small"
                               title="Обновить" OnClick="LoadAsync" />
            </MudStack>
        </MudStack>

        @* KPI cards *@
        <MudGrid Spacing="2">
            <MudItem xs="6" sm="3">
                <MudCard Elevation="1" Style="border-radius:14px;">
                    <MudCardContent Class="pa-4">
                        <MudStack Spacing="1">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudAvatar Size="Size.Small" Style="background:#e3f2fd;">
                                    <MudIcon Icon="@Icons.Material.Outlined.Group" Size="Size.Small" Style="color:#1976d2;" />
                                </MudAvatar>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Активных</MudText>
                            </MudStack>
                            <MudText Typo="Typo.h5" Style="font-weight:700;">@_dashboard.Kpis.ActiveEmployees</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">сотрудников</MudText>
                        </MudStack>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudCard Elevation="1" Style="border-radius:14px;">
                    <MudCardContent Class="pa-4">
                        <MudStack Spacing="1">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudAvatar Size="Size.Small" Style="background:#e8f5e9;">
                                    <MudIcon Icon="@Icons.Material.Outlined.CheckCircle" Size="Size.Small" Style="color:#388e3c;" />
                                </MudAvatar>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Завершаемость</MudText>
                            </MudStack>
                            <MudText Typo="Typo.h5" Style="font-weight:700;">@((int)(_dashboard.Kpis.AvgCompletionRate * 100))%</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">в среднем</MudText>
                        </MudStack>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudCard Elevation="1" Style="border-radius:14px;">
                    <MudCardContent Class="pa-4">
                        <MudStack Spacing="1">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudAvatar Size="Size.Small" Style="background:#fff3e0;">
                                    <MudIcon Icon="@Icons.Material.Outlined.Timer" Size="Size.Small" Style="color:#f57c00;" />
                                </MudAvatar>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Длительность</MudText>
                            </MudStack>
                            <MudText Typo="Typo.h5" Style="font-weight:700;">@FormatDuration(_dashboard.Kpis.AvgOnboardingDuration)</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">среднее время</MudText>
                        </MudStack>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudCard Elevation="1" Style="@($"border-radius:14px;{(_dashboard.Kpis.AtRiskEmployees > 0 ? "border:1.5px solid var(--mud-palette-error);" : "")}")">
                    <MudCardContent Class="pa-4">
                        <MudStack Spacing="1">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudAvatar Size="Size.Small" Style="background:#fce4ec;">
                                    <MudIcon Icon="@Icons.Material.Outlined.Warning" Size="Size.Small" Style="color:#c62828;" />
                                </MudAvatar>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Под риском</MudText>
                            </MudStack>
                            <MudText Typo="Typo.h5" Style="@($"font-weight:700;{(_dashboard.Kpis.AtRiskEmployees > 0 ? "color:var(--mud-palette-error);" : "")}")">
                                @_dashboard.Kpis.AtRiskEmployees
                            </MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">сотрудников</MudText>
                        </MudStack>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>

        @* Engagement trend *@
        <MudCard Elevation="1" Style="border-radius:14px;">
            <MudCardContent Class="pa-4">
                <MudStack Spacing="3">
                    <MudStack Row="true" AlignItems="AlignItems.Center">
                        <MudText Typo="Typo.subtitle2" Style="font-weight:700;">Активность</MudText>
                        <MudSpacer />
                        <MudStack Row="true" Spacing="1">
                            @foreach (var p in _periodOptions)
                            {
                                var days = p.Key;
                                <MudChip T="int" Value="@days" Size="Size.Small"
                                         Color="@(_trendDays == days ? Color.Primary : Color.Default)"
                                         Variant="@(_trendDays == days ? Variant.Filled : Variant.Outlined)"
                                         OnClick="@(() => ChangePeriodAsync(days))">
                                    @p.Value
                                </MudChip>
                            }
                        </MudStack>
                    </MudStack>

                    @if (_trendLoading)
                    {
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="90px" Style="border-radius:8px;" />
                    }
                    else if (_trendPoints.Count < 2)
                    {
                        <MudStack AlignItems="AlignItems.Center" Class="py-4">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Недостаточно данных за период</MudText>
                        </MudStack>
                    }
                    else
                    {
                        <MudStack Spacing="0">
                            @RenderTrendChart(_trendPoints)
                            <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mt-1">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@_trendPoints.First().Date.ToString("dd.MM")</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@_trendPoints.Last().Date.ToString("dd.MM")</MudText>
                            </MudStack>
                        </MudStack>
                    }
                </MudStack>
            </MudCardContent>
        </MudCard>

        @* Two-column layout: problem steps + scenarios *@
        <MudGrid Spacing="3">

            @* Top problem steps *@
            <MudItem xs="12" md="5">
                <MudCard Elevation="1" Style="border-radius:14px;height:100%;">
                    <MudCardContent Class="pa-4">
                        <MudStack Spacing="2">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudIcon Icon="@Icons.Material.Outlined.TrendingDown" Color="Color.Error" Size="Size.Small" />
                                <MudText Typo="Typo.subtitle2" Style="font-weight:700;">Проблемные шаги</MudText>
                            </MudStack>
                            @if (_dashboard.TopProblemSteps.Count == 0)
                            {
                                <MudStack AlignItems="AlignItems.Center" Class="py-4">
                                    <MudIcon Icon="@Icons.Material.Outlined.CheckCircleOutline" Color="Color.Success" />
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Проблемных шагов нет</MudText>
                                </MudStack>
                            }
                            else
                            {
                                @foreach (var step in _dashboard.TopProblemSteps)
                                {
                                    var dropPct = (int)(step.DropOffRate * 100);
                                    <MudPaper Elevation="0" Style="background:#fafafa;border-radius:10px;padding:10px 12px;">
                                        <MudStack Spacing="1">
                                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                                <MudStack Spacing="0" Style="flex:1;min-width:0;">
                                                    <MudText Typo="Typo.body2" Style="font-weight:600;">@step.StepName</MudText>
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@step.ScenarioName</MudText>
                                                </MudStack>
                                                <MudChip T="string" Size="Size.Small"
                                                         Color="@(dropPct >= 50 ? Color.Error : Color.Warning)"
                                                         Style="height:20px;flex-shrink:0;">
                                                    −@dropPct%
                                                </MudChip>
                                            </MudStack>
                                            <MudProgressLinear Value="@dropPct"
                                                               Color="@(dropPct >= 50 ? Color.Error : Color.Warning)"
                                                               Size="Size.Small" Rounded="true" />
                                        </MudStack>
                                    </MudPaper>
                                }
                            }
                        </MudStack>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            @* Active scenarios *@
            <MudItem xs="12" md="7">
                <MudCard Elevation="1" Style="border-radius:14px;height:100%;">
                    <MudCardContent Class="pa-4">
                        <MudStack Spacing="2">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudIcon Icon="@QwestrIcons.Navigation.Onboarding" Color="Color.Primary" Size="Size.Small" />
                                <MudText Typo="Typo.subtitle2" Style="font-weight:700;">Активные сценарии</MudText>
                            </MudStack>
                            @if (_dashboard.ActiveScenarios.Count == 0)
                            {
                                <MudStack AlignItems="AlignItems.Center" Class="py-4">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Нет активных сценариев</MudText>
                                </MudStack>
                            }
                            else
                            {
                                @foreach (var s in _dashboard.ActiveScenarios)
                                {
                                    var pct = (int)(s.CompletionRate * 100);
                                    <MudPaper Elevation="0" Style="background:#fafafa;border-radius:10px;padding:10px 12px;cursor:pointer;"
                                              @onclick='() => Nav.NavigateTo($"/analytics/scenarios/{s.ScenarioId}")'>
                                        <MudStack Spacing="1">
                                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                                <MudText Typo="Typo.body2" Style="font-weight:600;">@s.Name</MudText>
                                                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@s.Completed/@s.Assigned</MudText>
                                                    <MudText Typo="Typo.caption" Style="@($"font-weight:700;color:{PctColor(pct)};")">
                                                        @pct%
                                                    </MudText>
                                                </MudStack>
                                            </MudStack>
                                            <MudProgressLinear Value="@pct" Rounded="true" Size="Size.Small"
                                                               Color="@(pct >= 70 ? Color.Success : pct >= 40 ? Color.Warning : Color.Error)" />
                                        </MudStack>
                                    </MudPaper>
                                }
                            }
                        </MudStack>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>

        @* Latest insights *@
        @if (_dashboard.LatestInsights is not null)
        {
            <MudExpansionPanels Elevation="1">
                <MudExpansionPanel Style="border-radius:14px;" Expanded="true">
                    <TitleContent>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudIcon Icon="@QwestrIcons.Gamification.Sparkles" Color="Color.Secondary" Size="Size.Small" />
                            <MudText Typo="Typo.subtitle2" Style="font-weight:700;">AI Инсайты</MudText>
                            <MudChip T="string" Size="Size.Small" Color="Color.Default" Style="height:18px;">
                                @_dashboard.LatestInsights.GeneratedAt.ToString("dd.MM HH:mm")
                            </MudChip>
                            <MudSpacer />
                            <MudButton Variant="Variant.Text" Size="Size.Small"
                                       OnClick='() => Nav.NavigateTo("/analytics/insights")'>
                                Все инсайты
                            </MudButton>
                        </MudStack>
                    </TitleContent>
                    <ChildContent>
                        <MudStack Spacing="2" Class="pt-2">
                            @foreach (var ins in _dashboard.LatestInsights.Insights.Take(3))
                            {
                                var (sColor, sIcon) = SeverityStyle(ins.Severity);
                                <MudPaper Elevation="0" Style="border-radius:10px;padding:10px 12px;background:#fafafa;">
                                    <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="2">
                                        <MudIcon Icon="@sIcon" Color="@sColor" Size="Size.Small" Style="flex-shrink:0;margin-top:2px;" />
                                        <MudStack Spacing="0">
                                            <MudText Typo="Typo.body2" Style="font-weight:600;">@ins.Title</MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@ins.Description</MudText>
                                        </MudStack>
                                    </MudStack>
                                </MudPaper>
                            }
                        </MudStack>
                    </ChildContent>
                </MudExpansionPanel>
            </MudExpansionPanels>
        }

    </MudStack>
}

@code {
    private bool _authorized;
    private bool _loading = true;
    private bool _trendLoading;
    private DashboardResponse? _dashboard;
    private List<EngagementPointResponse> _trendPoints = [];
    private int _trendDays = 30;

    private static readonly Dictionary<int, string> _periodOptions = new()
    {
        [7]  = "7 дн.",
        [30] = "30 дн.",
        [90] = "90 дн.",
    };

    protected override async Task OnInitializedAsync()
    {
        var roleStr = Session.GetClaimFromToken(ClaimTypes.Role);
        var role = Enum.TryParse<UserRole>(roleStr, out var r) ? r : UserRole.Employee;
        if (role < UserRole.Manager) { Nav.NavigateTo("/dashboard"); return; }
        _authorized = true;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        var result = await AnalyticsApi.GetDashboardAsync();
        if (result.IsSuccess)
        {
            _dashboard = result.Data;
            _trendPoints = _dashboard!.EngagementTrend30Days.ToList();
        }
        else
        {
            Snackbar.Add(result.Error ?? "Ошибка загрузки", Severity.Error);
        }
        _loading = false;
    }

    private async Task ChangePeriodAsync(int days)
    {
        if (_trendDays == days) return;
        _trendDays = days;
        _trendLoading = true;
        var result = await AnalyticsApi.GetEngagementTrendAsync(days);
        if (result.IsSuccess) _trendPoints = result.Data!.Points.ToList();
        _trendLoading = false;
    }

    private async Task OpenExportAsync()
    {
        await DialogService.ShowAsync<ExportDialog>("Экспорт данных");
    }

    private static MarkupString RenderTrendChart(List<EngagementPointResponse> points)
    {
        const int w = 600, h = 90;
        var max = points.Max(p => p.ActiveUsers);
        if (max == 0) max = 1;
        var coords = points.Select((p, i) =>
        {
            var x = i * w / (double)(points.Count - 1);
            var y = h - 4 - p.ActiveUsers * (h - 8) / (double)max;
            return $"{x:F1},{y:F1}";
        }).ToList();
        var line = string.Join(" ", coords);
        var area = $"0,{h} {line} {w},{h}";
        var svg = "<svg viewBox=\"0 0 " + w + " " + h + "\" style=\"width:100%;height:" + h + "px;display:block;\" preserveAspectRatio=\"none\">"
            + "<defs><linearGradient id=\"tg\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">"
            + "<stop offset=\"0%\" stop-color=\"var(--mud-palette-primary)\" stop-opacity=\"0.28\"/>"
            + "<stop offset=\"100%\" stop-color=\"var(--mud-palette-primary)\" stop-opacity=\"0.02\"/>"
            + "</linearGradient></defs>"
            + "<polygon points=\"" + area + "\" fill=\"url(#tg)\"/>"
            + "<polyline points=\"" + line + "\" fill=\"none\" stroke=\"var(--mud-palette-primary)\" stroke-width=\"2.5\" stroke-linejoin=\"round\" stroke-linecap=\"round\"/>"
            + "</svg>";
        return (MarkupString)svg;
    }

    private static string FormatDuration(TimeSpan ts)
    {
        if (ts.TotalDays >= 1)    return $"{(int)ts.TotalDays} дн.";
        if (ts.TotalHours >= 1)   return $"{(int)ts.TotalHours} ч.";
        return $"{(int)ts.TotalMinutes} мин.";
    }

    private static string PctColor(int pct) =>
        pct >= 70 ? "var(--mud-palette-success)"
        : pct >= 40 ? "var(--mud-palette-warning)"
        : "var(--mud-palette-error)";

    private static (Color color, string icon) SeverityStyle(InsightSeverity s) => s switch
    {
        InsightSeverity.Critical => (Color.Error,   Icons.Material.Filled.Error),
        InsightSeverity.Warning  => (Color.Warning, Icons.Material.Filled.Warning),
        _                        => (Color.Info,    Icons.Material.Filled.Info),
    };
}
