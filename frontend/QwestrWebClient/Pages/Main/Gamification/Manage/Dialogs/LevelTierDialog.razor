@using Qwestr.Shared.Contracts.ApiDto.Gamification.Requests
@using Qwestr.Shared.Contracts.ApiDto.Gamification.Responses

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
            }
            <MudTextField @bind-Value="_title" Label="Название" Variant="Variant.Outlined"
                          FullWidth="true" MaxLength="100" Required="true" />
            <MudGrid Spacing="2">
                <MudItem xs="6">
                    <MudNumericField @bind-Value="_fromLevel" Label="От уровня" Variant="Variant.Outlined"
                                     Min="1" FullWidth="true" />
                </MudItem>
                <MudItem xs="6">
                    <MudNumericField @bind-Value="_toLevel" Label="До уровня" Variant="Variant.Outlined"
                                     Min="1" FullWidth="true" />
                </MudItem>
            </MudGrid>
            <MudStack Spacing="1">
                <MudTextField @bind-Value="_color" Label="Цвет (HEX или CSS)" Variant="Variant.Outlined"
                              FullWidth="true" Placeholder="#6C3FC5" />
                @if (!string.IsNullOrWhiteSpace(_color))
                {
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudText Typo="Typo.caption">Превью:</MudText>
                        <MudPaper Style="@($"background:{_color};border-radius:8px;padding:4px 14px;")" Elevation="0">
                            <MudText Typo="Typo.caption" Style="color:white;font-weight:600;">@_title</MudText>
                        </MudPaper>
                    </MudStack>
                }
            </MudStack>
            <MudTextField @bind-Value="_frameUrl" Label="URL рамки (опционально)" Variant="Variant.Outlined"
                          FullWidth="true" />
            <MudNumericField @bind-Value="_order" Label="Порядок сортировки" Variant="Variant.Outlined"
                             Min="1" FullWidth="true" />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Cancel()">Отмена</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">
            @(Existing is null ? "Создать" : "Сохранить")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public LevelTierResponse? Existing { get; set; }

    private string _title = "";
    private int _fromLevel = 1;
    private int _toLevel = 10;
    private string _color = "#6C3FC5";
    private string? _frameUrl;
    private int _order = 1;
    private string? _error;

    protected override void OnParametersSet()
    {
        if (Existing is null) return;
        _title    = Existing.Title;
        _fromLevel = Existing.FromLevel;
        _toLevel  = Existing.ToLevel;
        _color    = Existing.Color;
        _frameUrl = Existing.FrameUrl;
        _order    = Existing.Order;
    }

    private void Submit()
    {
        if (string.IsNullOrWhiteSpace(_title)) { _error = "Введите название"; return; }
        if (_fromLevel < 1 || _toLevel < _fromLevel) { _error = "Некорректный диапазон уровней"; return; }
        if (string.IsNullOrWhiteSpace(_color)) { _error = "Введите цвет"; return; }

        if (Existing is null)
            MudDialog.Close(DialogResult.Ok(new CreateLevelTierRequest(
                _order, _title.Trim(), _fromLevel, _toLevel, _color.Trim(), _frameUrl?.Trim())));
        else
            MudDialog.Close(DialogResult.Ok(new UpdateLevelTierRequest(
                _title.Trim(), _fromLevel, _toLevel, _color.Trim(), _frameUrl?.Trim())));
    }
}
