@page "/achievements"
@layout MainLayout

@using Client.Infrastructure.Api.Endpoints.Gamification
@using Qwestr.Shared.Contracts.ApiDto.Gamification.Responses

@inject GamificationAwardsApi AwardsApi
@inject GamificationProfileApi ProfileApi

<PageTitle>Достижения — Qwestr</PageTitle>

@if (_loading)
{
    <MudStack Spacing="3">
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="32px" Width="180px" />
        <MudGrid Spacing="2">
            @for (var i = 0; i < 6; i++)
            {
                <MudItem xs="12" sm="6" md="4">
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="110px" Style="border-radius:12px;" />
                </MudItem>
            }
        </MudGrid>
    </MudStack>
}
else
{
    <MudStack Spacing="5">

        @* Achievements *@
        <MudStack Spacing="2">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <MudIcon Icon="@Icons.Material.Outlined.EmojiEvents" Color="Color.Warning" Size="Size.Small" />
                <MudText Typo="Typo.subtitle1" Style="font-weight:700;">Достижения</MudText>
                @if (_achievements.Count > 0)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        @AchievementsEarnedCount() / @_achievements.Count получено
                    </MudText>
                }
            </MudStack>

            @if (_achievements.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Text" Dense="true">
                    Достижения пока не настроены
                </MudAlert>
            }
            else
            {
                <MudGrid Spacing="2">
                    @foreach (var a in _achievements)
                    {
                        var earned = _earnedMap.TryGetValue(a.Id, out var ea);
                        <MudItem xs="12" sm="6" md="4">
                            <MudCard Elevation="1"
                                     Style="@($"border-radius:14px;height:100%;{(earned ? "border:1.5px solid var(--mud-palette-success);" : "opacity:0.62;")}")">
                                <MudCardContent Class="pa-3">
                                    <MudStack Spacing="2">
                                        <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="2">
                                            <MudAvatar Size="Size.Medium"
                                                       Style="@($"background:{(earned ? "#fff9e6" : "#f5f5f5")};flex-shrink:0;")">
                                                @if (!string.IsNullOrEmpty(a.IconUrl))
                                                {
                                                    @((MarkupString)$"<img src=\"{a.IconUrl}\" style=\"width:28px;height:28px;object-fit:contain;{(!earned ? "filter:grayscale(1);" : "")}\" alt=\"\" />")
                                                }
                                                else
                                                {
                                                    <MudIcon Icon="@QwestrIcons.Gamification.Achievement"
                                                             Color="@(earned ? Color.Warning : Color.Default)" />
                                                }
                                            </MudAvatar>
                                            <MudStack Spacing="0" Style="flex:1;min-width:0;">
                                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                                    <MudText Typo="Typo.body2" Style="font-weight:700;line-height:1.3;">@a.Title</MudText>
                                                    @if (earned)
                                                    {
                                                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                                                                 Size="Size.Small"
                                                                 Style="color:var(--mud-palette-success);flex-shrink:0;" />
                                                    }
                                                </MudStack>
                                                @if (!string.IsNullOrEmpty(a.Description))
                                                {
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@a.Description</MudText>
                                                }
                                            </MudStack>
                                        </MudStack>

                                        @if (a.Rule is not null)
                                        {
                                            <MudPaper Elevation="0" Style="background:#f5f0ff;border-radius:8px;padding:6px 10px;">
                                                <MudText Typo="Typo.caption" Style="color:#7b5ccc;">@RuleSummary(a.Rule)</MudText>
                                            </MudPaper>
                                        }

                                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                            <MudStack Row="true" Spacing="1">
                                                @if (a.XpBonus > 0)
                                                {
                                                    <MudChip T="string" Size="Size.Small" Color="Color.Info"
                                                             Style="height:20px;font-size:0.7rem;">
                                                        +@a.XpBonus XP
                                                    </MudChip>
                                                }
                                                @if (a.CoinsBonus > 0)
                                                {
                                                    <MudChip T="string" Size="Size.Small" Color="Color.Warning"
                                                             Style="height:20px;font-size:0.7rem;">
                                                        +@a.CoinsBonus монет
                                                    </MudChip>
                                                }
                                            </MudStack>
                                            @if (earned && ea is not null)
                                            {
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                    @ea.EarnedAt.ToString("dd.MM.yy")
                                                </MudText>
                                            }
                                        </MudStack>
                                    </MudStack>
                                </MudCardContent>
                            </MudCard>
                        </MudItem>
                    }
                </MudGrid>
            }
        </MudStack>

        @* Badges *@
        <MudStack Spacing="2">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <MudIcon Icon="@Icons.Material.Outlined.LocalPolice" Color="Color.Secondary" Size="Size.Small" />
                <MudText Typo="Typo.subtitle1" Style="font-weight:700;">Бейджи</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">Выдаются менеджером</MudText>
            </MudStack>

            @if (_badges.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Text" Dense="true">
                    Бейджи пока не настроены
                </MudAlert>
            }
            else
            {
                <MudGrid Spacing="2">
                    @foreach (var b in _badges)
                    {
                        var earned = _earnedMap.TryGetValue(b.Id, out var eb);
                        <MudItem xs="12" sm="6" md="4">
                            <MudCard Elevation="1"
                                     Style="@($"border-radius:14px;height:100%;{(earned ? "border:1.5px solid var(--mud-palette-success);" : "opacity:0.62;")}")">
                                <MudCardContent Class="pa-3">
                                    <MudStack Spacing="2">
                                        <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="2">
                                            <MudAvatar Size="Size.Medium"
                                                       Style="@($"background:{(earned ? "#e8f5e9" : "#f5f5f5")};flex-shrink:0;")">
                                                @if (!string.IsNullOrEmpty(b.IconUrl))
                                                {
                                                    @((MarkupString)$"<img src=\"{b.IconUrl}\" style=\"width:28px;height:28px;object-fit:contain;{(!earned ? "filter:grayscale(1);" : "")}\" alt=\"\" />")
                                                }
                                                else
                                                {
                                                    <MudIcon Icon="@QwestrIcons.Gamification.Badge"
                                                             Color="@(earned ? Color.Primary : Color.Default)" />
                                                }
                                            </MudAvatar>
                                            <MudStack Spacing="0" Style="flex:1;min-width:0;">
                                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                                    <MudText Typo="Typo.body2" Style="font-weight:700;line-height:1.3;">@b.Title</MudText>
                                                    @if (earned)
                                                    {
                                                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                                                                 Size="Size.Small"
                                                                 Style="color:var(--mud-palette-success);flex-shrink:0;" />
                                                    }
                                                </MudStack>
                                                @if (!string.IsNullOrEmpty(b.Description))
                                                {
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@b.Description</MudText>
                                                }
                                            </MudStack>
                                        </MudStack>

                                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                            <MudStack Row="true" Spacing="1">
                                                @if (b.XpBonus > 0)
                                                {
                                                    <MudChip T="string" Size="Size.Small" Color="Color.Info"
                                                             Style="height:20px;font-size:0.7rem;">
                                                        +@b.XpBonus XP
                                                    </MudChip>
                                                }
                                                @if (b.CoinsBonus > 0)
                                                {
                                                    <MudChip T="string" Size="Size.Small" Color="Color.Warning"
                                                             Style="height:20px;font-size:0.7rem;">
                                                        +@b.CoinsBonus монет
                                                    </MudChip>
                                                }
                                                @if (!earned)
                                                {
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-style:italic;">
                                                        Выдаётся вручную
                                                    </MudText>
                                                }
                                            </MudStack>
                                            @if (earned && eb is not null)
                                            {
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                    @eb.EarnedAt.ToString("dd.MM.yy")
                                                </MudText>
                                            }
                                        </MudStack>
                                    </MudStack>
                                </MudCardContent>
                            </MudCard>
                        </MudItem>
                    }
                </MudGrid>
            }
        </MudStack>

    </MudStack>
}

@code {
    private bool _loading = true;
    private List<AwardResponse> _achievements = [];
    private List<AwardResponse> _badges = [];
    private Dictionary<Guid, EarnedAwardResponse> _earnedMap = [];

    protected override async Task OnInitializedAsync()
    {
        var awardsTask = AwardsApi.GetAwardsAsync();
        var earnedTask = ProfileApi.GetMyEarnedAwardsAsync();
        await Task.WhenAll(awardsTask, earnedTask);

        if (awardsTask.Result.IsSuccess)
        {
            var all = awardsTask.Result.Data!.Items.Where(a => a.IsActive).ToList();
            _achievements = all.Where(a => a.IssuanceType == "Automatic").ToList();
            _badges       = all.Where(a => a.IssuanceType == "Manual").ToList();
        }

        if (earnedTask.Result.IsSuccess)
        {
            foreach (var ea in earnedTask.Result.Data!.Items)
                _earnedMap.TryAdd(ea.AwardId, ea);
        }

        _loading = false;
    }

    private int AchievementsEarnedCount() =>
        _achievements.Count(a => _earnedMap.ContainsKey(a.Id));

    private static string RuleSummary(AwardRuleResponse rule)
    {
        var trigger = rule.Trigger switch
        {
            "StepCompleted"     => "завершён шаг",
            "ScenarioCompleted" => "завершён сценарий",
            "TestPassed"        => "пройден тест",
            "LevelReached"      => "достигнут уровень",
            "DailyActivity"     => "активность",
            "PointsAccumulated" => "накоплен опыт",
            _                   => rule.Trigger,
        };
        var text = rule.Condition switch
        {
            "Count"           => $"{trigger} × {rule.TargetValue}",
            "CountWithFilter" => $"{trigger} × {rule.TargetValue} с фильтром",
            "Threshold"       => $"{trigger} ≥ {rule.TargetValue}",
            "Streak"          => $"{trigger} × {rule.TargetValue} подряд",
            _                 => $"{trigger} {rule.Condition} {rule.TargetValue}",
        };
        if (rule.FilterParams?.TryGetValue("minScore", out var ms) == true)
            text += $" (балл ≥{ms}%)";
        return text;
    }
}
