@using System.Text.Encodings.Web
@using System.Text.Json
@using System.Text.Json.Serialization

<MudStack Spacing="3">
    <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Задание</MudText>

    <MudTextField T="string" Value="_contentObj.Text"
                  ValueChanged="@((string? v) => ContentChangedInp(v))"
                  Label="Описание задания"
                  Variant="Variant.Outlined"
                  FullWidth="true"
                  Lines="5"
                  ReadOnly="IsReadOnly"
                  MaxLength="5000" />

    <MudSwitch T="bool" Value="_requiresReview"
               ValueChanged="OnRequiresReviewChanged"
               Label="Требует проверки"
               Color="Color.Primary"
               Disabled="IsReadOnly" />

    @if (_requiresReview)
    {
        <MudTextField Value="_reviewerInstructions"
                      ValueChanged="@((string? v) => { _reviewerInstructions = v; SaveSettings(); })"
                      Label="Инструкция для проверяющего"
                      Variant="Variant.Outlined"
                      FullWidth="true"
                      Lines="3"
                      ReadOnly="IsReadOnly"
                      MaxLength="2000" />
    }
</MudStack>

@code {
    [Parameter] public string? Content { get; set; }
    private TaskContent _contentObj = new TaskContent("");
    [Parameter] public EventCallback<string?> ContentChanged { get; set; }
    [Parameter] public string? Settings { get; set; }
    [Parameter] public EventCallback<string?> SettingsChanged { get; set; }
    [Parameter] public bool IsReadOnly { get; set; }

    private static readonly JsonSerializerOptions JsonOptions = new()
    {
        Encoder = JavaScriptEncoder.UnsafeRelaxedJsonEscaping
    };
    
    private bool _requiresReview;
    private string? _reviewerInstructions;

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrEmpty(Settings))
        {
            try
            {
                var s = JsonSerializer.Deserialize<TaskSettings>(Settings);
                if (s is not null)
                {
                    _requiresReview = s.RequiresReview;
                    _reviewerInstructions = s.ReviewerInstructions;
                }
                
            }
            catch { }
        }

        if (!string.IsNullOrWhiteSpace(Content))
        {
            try
            {
                var c = JsonSerializer.Deserialize<TaskContent>(Content, JsonOptions);
                if (c is not null)
                {
                    _contentObj = c;
                }
            }
            catch { }
        }
    }

    private void OnRequiresReviewChanged(bool value)
    {
        _requiresReview = value;
        if (!_requiresReview) _reviewerInstructions = null;
        SaveSettings();
    }

    private void SaveSettings()
    {
        var json = JsonSerializer.Serialize(
            new TaskSettings(_requiresReview, _reviewerInstructions));
        _ = SettingsChanged.InvokeAsync(json);
    }

    private record TaskSettings(
        [property: JsonPropertyName("requiresReview")] bool RequiresReview,
        [property: JsonPropertyName("reviewerInstructions")] string? ReviewerInstructions);
    
    
    private record TaskContent([property: JsonPropertyName("text")] string Text);

    private Task ContentChangedInp(string? v)
    {
        _contentObj = new TaskContent(v ?? "");
        var json = JsonSerializer.Serialize(_contentObj, JsonOptions);
        return ContentChanged.InvokeAsync(json);
    }
}
