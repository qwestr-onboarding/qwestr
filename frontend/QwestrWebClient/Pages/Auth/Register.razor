@page "/register"
@layout AuthLayout

@using Client.Infrastructure.Auth
@using Client.Infrastructure.Services
@using Qwestr.Shared.Contracts.ApiDto.Identity.Auth.Requests
@using System.Text.RegularExpressions

@inject BffAuthClient BffAuth
@inject TenantResolver TenantResolver
@inject NavigationManager Nav

<PageTitle>Регистрация компании — Qwestr</PageTitle>

<RouteGuard Mode="RouteGuardMode.GuestOnMain">
    <MudPaper Outlined="true" Style="width:100%;max-width:500px;padding:40px 40px;border-radius:16px;" Elevation="0">
        <MudStack Spacing="4">
            <MudStack AlignItems="AlignItems.Center" Spacing="1">
                <MudText Typo="Typo.h5" Align="Align.Center" Style="font-weight:700; letter-spacing:-0.5px;">
                    Qwestr
                </MudText>
                <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary">
                    Создайте аккаунт компании
                </MudText>
            </MudStack>

            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true" ShowCloseIcon="true"
                          CloseIconClicked="() => _error = null">
                    @_error
                </MudAlert>
            }

            <MudTextField @bind-Value="_companyName"
                          Label="Название компании"
                          Variant="Variant.Outlined"
                          FullWidth="true"
                          Disabled="_loading" />

            <MudTextField @bind-Value="_subdomain"
                          Label="Поддомен"
                          Variant="Variant.Outlined"
                          FullWidth="true"
                          Disabled="_loading"
                          HelperText="@(_subdomain.Length > 0 ? $"{_subdomain}.{TenantResolver.BaseDomain}" : $"например: company.{TenantResolver.BaseDomain}")"
                          HelperTextOnFocus="false"
                          Error="@(_subdomainError is not null)"
                          ErrorText="@_subdomainError"
                          OnBlur="ValidateSubdomain" />

            <MudTextField @bind-Value="_email"
                          Label="Email владельца"
                          InputType="InputType.Email"
                          Variant="Variant.Outlined"
                          FullWidth="true"
                          Disabled="_loading" />

            <MudGrid Spacing="2">
                <MudItem xs="6">
                    <MudTextField @bind-Value="_firstName"
                                  Label="Имя"
                                  Variant="Variant.Outlined"
                                  FullWidth="true"
                                  Disabled="_loading" />
                </MudItem>
                <MudItem xs="6">
                    <MudTextField @bind-Value="_lastName"
                                  Label="Фамилия"
                                  Variant="Variant.Outlined"
                                  FullWidth="true"
                                  Disabled="_loading" />
                </MudItem>
            </MudGrid>

            <MudTextField @bind-Value="_password"
                          Label="Пароль"
                          InputType="@_passwordInputType"
                          Variant="Variant.Outlined"
                          FullWidth="true"
                          Disabled="_loading"
                          Adornment="Adornment.End"
                          AdornmentIcon="@_passwordToggleIcon"
                          OnAdornmentClick="TogglePasswordVisibility" />

            <MudTextField @bind-Value="_confirmPassword"
                          Label="Подтверждение пароля"
                          InputType="@_passwordInputType"
                          Variant="Variant.Outlined"
                          FullWidth="true"
                          Disabled="_loading"
                          Error="@(_passwordMismatch)"
                          ErrorText="Пароли не совпадают" />

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Size="Size.Large"
                       OnClick="Submit"
                       Disabled="_loading">
                @if (_loading)
                {
                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                    <MudText Class="ms-2">Создание...</MudText>
                }
                else
                {
                    <MudText>Создать компанию</MudText>
                }
            </MudButton>

            <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary">
                Уже есть аккаунт?
                <MudLink Href="/login">Войти</MudLink>
            </MudText>
        </MudStack>
    </MudPaper>
</RouteGuard>

@code {
    private string _companyName = "";
    private string _subdomain = "";
    private string _email = "";
    private string _firstName = "";
    private string _lastName = "";
    private string _password = "";
    private string _confirmPassword = "";

    private string? _error;
    private string? _subdomainError;
    private bool _passwordMismatch;
    private bool _loading;

    private InputType _passwordInputType = InputType.Password;
    private string _passwordToggleIcon = Icons.Material.Outlined.VisibilityOff;

    private static readonly Regex SubdomainRegex =
        new(@"^[a-z0-9]([a-z0-9\-]{1,61}[a-z0-9])?$", RegexOptions.Compiled);

    private void ValidateSubdomain()
    {
        if (string.IsNullOrWhiteSpace(_subdomain))
        {
            _subdomainError = "Поддомен обязателен.";
            return;
        }
        if (_subdomain.Length < 3 || _subdomain.Length > 63)
        {
            _subdomainError = "Поддомен должен содержать от 3 до 63 символов.";
            return;
        }
        if (!SubdomainRegex.IsMatch(_subdomain))
        {
            _subdomainError = "Только строчные буквы, цифры и дефис. Не может начинаться или заканчиваться на дефис.";
            return;
        }
        _subdomainError = null;
    }

    private async Task Submit()
    {
        _error = null;
        _passwordMismatch = false;

        ValidateSubdomain();

        if (string.IsNullOrWhiteSpace(_companyName) ||
            string.IsNullOrWhiteSpace(_email) ||
            string.IsNullOrWhiteSpace(_firstName) ||
            string.IsNullOrWhiteSpace(_lastName) ||
            string.IsNullOrWhiteSpace(_password))
        {
            _error = "Заполните все обязательные поля.";
            return;
        }

        if (_subdomainError is not null) return;

        if (_password != _confirmPassword)
        {
            _passwordMismatch = true;
            return;
        }

        _loading = true;
        try
        {
            var result = await BffAuth.RegisterAsync(new RegisterTenantRequest(
                _companyName, _subdomain, _email, _password, _firstName, _lastName));

            if (!result.IsSuccess)
            {
                _error = result.Error ?? "Не удалось создать компанию. Попробуйте ещё раз.";
                return;
            }

            Nav.NavigateTo(
                $"https://{_subdomain}.{TenantResolver.BaseDomain}/dashboard",
                forceLoad: true);
        }
        finally
        {
            _loading = false;
        }
    }

    private void TogglePasswordVisibility()
    {
        if (_passwordInputType == InputType.Password)
        {
            _passwordInputType = InputType.Text;
            _passwordToggleIcon = Icons.Material.Outlined.Visibility;
        }
        else
        {
            _passwordInputType = InputType.Password;
            _passwordToggleIcon = Icons.Material.Outlined.VisibilityOff;
        }
    }
}
