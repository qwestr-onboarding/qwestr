@page "/invitations/accept"
@layout AuthLayout

@using Client.Infrastructure.Auth
@using Client.Infrastructure.Api.Endpoints
@using Client.Infrastructure.Services
@using Qwestr.Shared.Contracts.ApiDto.Identity.Invitations.Requests
@using Qwestr.Shared.Contracts.ApiDto.Identity.Invitations.Responses

@inject BffAuthClient BffAuth
@inject InvitationsApi InvitationsApi
@inject TokenStorageService TokenStorage
@inject JwtAuthStateProvider AuthStateProvider
@inject TenantResolver TenantResolver
@inject NavigationManager Nav

<PageTitle>Принять приглашение — Qwestr</PageTitle>

<RouteGuard Mode="RouteGuardMode.GuestOnTenant">
    <MudPaper Outlined="true" Style="width:100%;max-width:440px;padding:40px 36px;border-radius:16px;" Elevation="0">
        <MudStack Spacing="4">

            @if (_validating)
            {
                <MudStack AlignItems="AlignItems.Center" Spacing="3">
                    <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Проверка приглашения...</MudText>
                </MudStack>
            }
            else if (_invalidLink)
            {
                <MudStack AlignItems="AlignItems.Center" Spacing="1">
                    <MudText Typo="Typo.h5" Align="Align.Center" Style="font-weight:700;letter-spacing:-0.5px;">
                        Qwestr
                    </MudText>
                </MudStack>
                <MudAlert Severity="Severity.Error" Dense="true">
                    Ссылка недействительна. Попросите новое приглашение у администратора.
                </MudAlert>
            }
            else if (_expired)
            {
                <MudStack AlignItems="AlignItems.Center" Spacing="1">
                    <MudText Typo="Typo.h5" Align="Align.Center" Style="font-weight:700;letter-spacing:-0.5px;">
                        Qwestr
                    </MudText>
                </MudStack>
                <MudAlert Severity="Severity.Warning" Dense="true">
                    Срок действия приглашения истёк. Попросите новое приглашение у администратора.
                </MudAlert>
            }
            else
            {
                <MudStack AlignItems="AlignItems.Center" Spacing="1">
                    <MudText Typo="Typo.h5" Align="Align.Center" Style="font-weight:700;letter-spacing:-0.5px;">
                        Qwestr
                    </MudText>
                    <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary">
                        Вас пригласили в <strong>@_preview!.CompanyName</strong>. Создайте пароль для входа.
                    </MudText>
                </MudStack>

                <MudPaper Outlined="true" Style="border-radius:8px;padding:12px 16px;" Elevation="0">
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Email</MudText>
                        <MudText Typo="Typo.body2">@_preview!.Email</MudText>
                    </MudStack>
                </MudPaper>

                @if (_error is not null)
                {
                    <MudAlert Severity="Severity.Error" Dense="true" ShowCloseIcon="true"
                              CloseIconClicked="() => _error = null">
                        @_error
                    </MudAlert>
                }

                <MudGrid Spacing="2">
                    <MudItem xs="6">
                        <MudTextField @bind-Value="_firstName"
                                      Label="Имя"
                                      Variant="Variant.Outlined"
                                      FullWidth="true"
                                      Disabled="_loading" />
                    </MudItem>
                    <MudItem xs="6">
                        <MudTextField @bind-Value="_lastName"
                                      Label="Фамилия"
                                      Variant="Variant.Outlined"
                                      FullWidth="true"
                                      Disabled="_loading" />
                    </MudItem>
                </MudGrid>

                <MudTextField @bind-Value="_password"
                              Label="Пароль"
                              InputType="@_passwordInputType"
                              Variant="Variant.Outlined"
                              FullWidth="true"
                              Disabled="_loading"
                              Adornment="Adornment.End"
                              AdornmentIcon="@_passwordToggleIcon"
                              OnAdornmentClick="TogglePasswordVisibility" />

                <MudTextField @bind-Value="_confirmPassword"
                              Label="Подтверждение пароля"
                              InputType="@_passwordInputType"
                              Variant="Variant.Outlined"
                              FullWidth="true"
                              Disabled="_loading"
                              Error="@_passwordMismatch"
                              ErrorText="Пароли не совпадают" />

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           Size="Size.Large"
                           OnClick="Submit"
                           Disabled="_loading">
                    @if (_loading)
                    {
                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                        <MudText Class="ms-2">Сохранение...</MudText>
                    }
                    else
                    {
                        <MudText>Принять приглашение</MudText>
                    }
                </MudButton>
            }

        </MudStack>
    </MudPaper>
</RouteGuard>

@code {
    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    private InvitationPreviewResponse? _preview;
    private bool _validating = true;
    private bool _invalidLink;
    private bool _expired;

    private string _firstName = "";
    private string _lastName = "";
    private string _password = "";
    private string _confirmPassword = "";

    private string? _error;
    private bool _passwordMismatch;
    private bool _loading;

    private InputType _passwordInputType = InputType.Password;
    private string _passwordToggleIcon = Icons.Material.Outlined.VisibilityOff;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        if (string.IsNullOrEmpty(Token))
        {
            _validating = false;
            _invalidLink = true;
            StateHasChanged();
            return;
        }

        var subdomain = TenantResolver.GetSubdomain()!;
        var result = await InvitationsApi.ValidateAsync(Token, subdomain);

        _validating = false;

        if (result.IsSuccess)
        {
            _preview = result.Data;
        }
        else if (result.Error == "Invitation has expired.")
        {
            _expired = true;
        }
        else
        {
            _invalidLink = true;
        }

        StateHasChanged();
    }

    private async Task Submit()
    {
        _error = null;
        _passwordMismatch = false;

        if (string.IsNullOrWhiteSpace(_firstName) || string.IsNullOrWhiteSpace(_lastName) ||
            string.IsNullOrWhiteSpace(_password))
        {
            _error = "Заполните все обязательные поля.";
            return;
        }

        if (_password != _confirmPassword)
        {
            _passwordMismatch = true;
            return;
        }

        _loading = true;
        try
        {
            var result = await BffAuth.AcceptInvitationAsync(
                new AcceptInvitationRequest(Token!, _password, _firstName, _lastName));

            if (!result.IsSuccess)
            {
                _error = result.Error ?? "Не удалось принять приглашение. Попробуйте ещё раз.";
                return;
            }

            var data = result.Data!;
            TokenStorage.SetToken(data.AccessToken, data.ExpiresAt);
            AuthStateProvider.NotifyAuthStateChanged();
            Nav.NavigateTo("/dashboard");
        }
        finally
        {
            _loading = false;
        }
    }

    private void TogglePasswordVisibility()
    {
        if (_passwordInputType == InputType.Password)
        {
            _passwordInputType = InputType.Text;
            _passwordToggleIcon = Icons.Material.Outlined.Visibility;
        }
        else
        {
            _passwordInputType = InputType.Password;
            _passwordToggleIcon = Icons.Material.Outlined.VisibilityOff;
        }
    }
}