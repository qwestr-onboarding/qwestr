@page "/forgot-password"
@layout AuthLayout

@using Client.Infrastructure.Auth
@using Client.Infrastructure.Services
@using Qwestr.Shared.Contracts.ApiDto.Identity.Auth.Requests

@inject BffAuthClient BffAuth
@inject TenantResolver TenantResolver
@inject NavigationManager Nav

<PageTitle>Восстановление пароля — Qwestr</PageTitle>

<RouteGuard Mode="RouteGuardMode.Public">
    <MudPaper Outlined="true" Style="width:100%;max-width:420px;padding:40px 36px;border-radius:16px;" Elevation="0">
        <MudStack Spacing="4">
            <MudStack AlignItems="AlignItems.Center" Spacing="1">
                <MudText Typo="Typo.h5" Align="Align.Center" Style="font-weight:700; letter-spacing:-0.5px;">
                    Qwestr
                </MudText>
                <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary">
                    Введите email — мы отправим ссылку для сброса пароля
                </MudText>
            </MudStack>

            @if (_sent)
            {
                <MudAlert Severity="Severity.Success" Dense="true">
                    Письмо отправлено. Проверьте почту и перейдите по ссылке.
                </MudAlert>
            }
            else
            {
                @if (_error is not null)
                {
                    <MudAlert Severity="Severity.Error" Dense="true" ShowCloseIcon="true"
                              CloseIconClicked="() => _error = null">
                        @_error
                    </MudAlert>
                }

                <MudTextField @bind-Value="_email"
                              Label="Эл. почта"
                              InputType="InputType.Email"
                              Variant="Variant.Outlined"
                              FullWidth="true"
                              Disabled="_loading"
                              @onkeydown="OnKeyDown" Immediate="true" />

                @if (TenantResolver.IsMainDomain)
                {
                    <MudTextField @bind-Value="_subdomain"
                                  Label="Поддомен организации"
                                  Variant="Variant.Outlined"
                                  FullWidth="true"
                                  Disabled="_loading"
                                  Adornment="Adornment.End"
                                  AdornmentText="@("." + TenantResolver.BaseDomain)"
                                  @onkeydown="OnKeyDown" Immediate="true" />
                }

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           Size="Size.Large"
                           OnClick="Submit"
                           Disabled="_loading">
                    @if (_loading)
                    {
                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                        <MudText Class="ms-2">Отправка...</MudText>
                    }
                    else
                    {
                        <MudText>Отправить письмо</MudText>
                    }
                </MudButton>
            }

            <MudLink Href="/login" Typo="Typo.body2" Align="Align.Center">
                Вернуться ко входу
            </MudLink>
        </MudStack>
    </MudPaper>
</RouteGuard>

@code {
    private string _email = "";
    private string _subdomain = "";
    private string? _error;
    private bool _loading;
    private bool _sent;

    private async Task Submit()
    {
        _error = null;

        if (string.IsNullOrWhiteSpace(_email))
        {
            _error = "Введите адрес электронной почты.";
            return;
        }

        var subdomain = TenantResolver.GetSubdomain() ?? _subdomain.Trim();
        if (string.IsNullOrEmpty(subdomain))
        {
            _error = "Укажите поддомен организации.";
            return;
        }

        _loading = true;
        try
        {
            var result = await BffAuth.ForgotPasswordAsync(
                new RequestPasswordResetRequest(_email, subdomain));

            if (!result.IsSuccess)
            {
                _error = result.Error ?? "Не удалось отправить письмо. Попробуйте позже.";
                return;
            }

            _sent = true;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Submit();
    }
}
