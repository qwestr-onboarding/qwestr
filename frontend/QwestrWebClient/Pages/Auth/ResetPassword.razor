@page "/password/reset"
@layout AuthLayout

@using Client.Infrastructure.Auth
@using Qwestr.Shared.Contracts.ApiDto.Identity.Auth.Requests

@inject BffAuthClient BffAuth
@inject NavigationManager Nav

<PageTitle>Новый пароль — Qwestr</PageTitle>

<RouteGuard Mode="RouteGuardMode.PublicOnly">
    <MudPaper Outlined="true" Style="width:100%;max-width:420px;padding:40px 36px;border-radius:16px;" Elevation="0">
        <MudStack Spacing="4">
            <MudStack AlignItems="AlignItems.Center" Spacing="1">
                <MudText Typo="Typo.h5" Align="Align.Center" Style="font-weight:700; letter-spacing:-0.5px;">
                    Qwestr
                </MudText>
                <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary">
                    Придумайте новый пароль для входа
                </MudText>
            </MudStack>

            @if (_tokenMissing)
            {
                <MudAlert Severity="Severity.Error" Dense="true">
                    Ссылка недействительна или истекла. Запросите сброс пароля повторно.
                </MudAlert>
                <MudLink Href="/forgot-password" Typo="Typo.body2" Style="align-self: center">
                    Запросить сброс пароля
                </MudLink>
            }
            else if (_success)
            {
                <MudAlert Severity="Severity.Success" Dense="true">
                    Пароль успешно изменён. Войдите с новым паролем.
                </MudAlert>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           OnClick="@(() => Nav.NavigateTo("/login"))">
                    Войти
                </MudButton>
            }
            else
            {
                @if (_error is not null)
                {
                    <MudAlert Severity="Severity.Error" Dense="true" ShowCloseIcon="true"
                              CloseIconClicked="() => _error = null">
                        @_error
                    </MudAlert>
                }

                <MudTextField @bind-Value="_password"
                              Label="Новый пароль"
                              InputType="@_passwordInputType"
                              Variant="Variant.Outlined"
                              FullWidth="true"
                              Disabled="_loading"
                              Adornment="Adornment.End"
                              AdornmentIcon="@_passwordToggleIcon"
                              OnAdornmentClick="TogglePasswordVisibility" />

                <MudTextField @bind-Value="_confirmPassword"
                              Label="Подтверждение пароля"
                              InputType="@_passwordInputType"
                              Variant="Variant.Outlined"
                              FullWidth="true"
                              Disabled="_loading"
                              Error="@_passwordMismatch"
                              ErrorText="Пароли не совпадают" />

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           Size="Size.Large"
                           OnClick="Submit"
                           Disabled="_loading">
                    @if (_loading)
                    {
                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                        <MudText Class="ms-2">Сохранение...</MudText>
                    }
                    else
                    {
                        <MudText>Сохранить пароль</MudText>
                    }
                </MudButton>
            }
        </MudStack>
    </MudPaper>
</RouteGuard>

@code {
    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    private string _password = "";
    private string _confirmPassword = "";
    private string? _error;
    private bool _passwordMismatch;
    private bool _loading;
    private bool _tokenMissing;
    private bool _success;

    private InputType _passwordInputType = InputType.Password;
    private string _passwordToggleIcon = Icons.Material.Outlined.VisibilityOff;

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender) return;
        if (string.IsNullOrEmpty(Token))
        {
            _tokenMissing = true;
            StateHasChanged();
        }
    }

    private async Task Submit()
    {
        _error = null;
        _passwordMismatch = false;

        if (string.IsNullOrWhiteSpace(_password))
        {
            _error = "Введите новый пароль.";
            return;
        }

        if (_password != _confirmPassword)
        {
            _passwordMismatch = true;
            return;
        }

        _loading = true;
        try
        {
            var result = await BffAuth.ResetPasswordAsync(new ResetPasswordRequest(Token!, _password));

            if (!result.IsSuccess)
            {
                _error = result.Error ?? "Не удалось изменить пароль. Попробуйте ещё раз.";
                return;
            }

            _success = true;
        }
        finally
        {
            _loading = false;
        }
    }

    private void TogglePasswordVisibility()
    {
        if (_passwordInputType == InputType.Password)
        {
            _passwordInputType = InputType.Text;
            _passwordToggleIcon = Icons.Material.Outlined.Visibility;
        }
        else
        {
            _passwordInputType = InputType.Password;
            _passwordToggleIcon = Icons.Material.Outlined.VisibilityOff;
        }
    }
}
